diff --git a/src/SleighHome.h b/src/SleighHome.h
new file mode 100644
index 0000000..20a08e0
--- /dev/null
+++ b/src/SleighHome.h
@@ -0,0 +1,33 @@
+// SPDX-FileCopyrightText: 2026
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+#ifndef RZ_GHIDRA_SLEIGHHOME_H
+#define RZ_GHIDRA_SLEIGHHOME_H
+
+#include <string>
+#include <rz_util.h>
+
+static inline std::string RzGhidraRuntimeSleighHome()
+{
+	RzPath *sys_path = rz_path_new();
+	if(!sys_path)
+		return "";
+	char *libdir = rz_path_libdir(sys_path);
+	rz_path_free(sys_path);
+	if(!libdir)
+		return "";
+
+	char *path = rz_file_path_join(libdir, RZ_JOIN_3_PATHS("rizin", "plugins", "rz_ghidra_sleigh"));
+	rz_mem_free(libdir);
+
+	if(!path)
+		return "";
+
+	std::string result;
+	if(rz_file_is_directory(path))
+		result = path;
+	rz_mem_free(path);
+	return result;
+}
+
+#endif
