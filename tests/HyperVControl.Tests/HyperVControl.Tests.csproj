<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/HyperVControl/HyperVControl.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- The recording mock of the Hyper-V module; staged into a temp directory per test scenario. -->
    <None Include="MockHyperV\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
