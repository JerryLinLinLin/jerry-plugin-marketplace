diff --git a/src/rz-plugin/data.cpp b/src/rz-plugin/data.cpp
index c25fabe..6305c68 100644
--- a/src/rz-plugin/data.cpp
+++ b/src/rz-plugin/data.cpp
@@ -386,7 +386,9 @@ void RizinDatabase::fetchFunctionCallingconvention(Function &function, RzAnalysi
  */
 void RizinDatabase::fetchFunctionReturnType(Function &function, RzAnalysisFunction &rzfnc) const
 {
-	function.returnType = Type("void");
+	// An unknown prototype does not prove a void return. Forcing void here
+	// lets RetDec optimize away the entire calculation of a pure function.
+	function.returnType = Type("");
 	char* key = rz_analysis_function_name_resolve(_rzcore.analysis, rzfnc.name);
 	auto typedb = rz_analysis_get_type_db(_rzcore.analysis);
 
diff --git a/src/rz-plugin/rzretdec.cpp b/src/rz-plugin/rzretdec.cpp
index c294ab4..3ce144f 100644
--- a/src/rz-plugin/rzretdec.cpp
+++ b/src/rz-plugin/rzretdec.cpp
@@ -180,13 +180,19 @@ void createConfigHashFile(const retdec::config::Config& config)
  */
 retdec::config::Config loadDefaultConfig()
 {
-	// Perhaps support signatures are installed in RZ_PLUGDIR?
-	auto plugdir = rz_str_home(RZ_PLUGINS);
+	// Resolve support files from the portable runtime instead of the user's
+	// plugin directory. A moved installation must keep the same type database.
+	auto sysPath = rz_path_new();
+	if (!sysPath) throw DecompilationError("Unable to resolve the runtime support path");
+	auto plugdir = rz_path_system(sysPath, RZ_JOIN_3_PATHS("lib", "rizin", "plugins"));
+	rz_path_free(sysPath);
+	if (!plugdir) throw DecompilationError("Unable to resolve the runtime support path");
 
 	// Loads configuration from file - also contains default config.
 	auto rdConf = retdec::config::Config::fromJsonString(DefaultConfigJSON);
 	// Paths to the signatures, etc.
 	rdConf.parameters.fixRelativePaths(plugdir);
+	rz_mem_free(plugdir);
 
 	return rdConf;
 }
